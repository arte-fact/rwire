/target

# Local env file (the checked-in template is .env.local)
/.env

# SQLite database files
*.db
*.db-shm
*.db-wal

# Playwright MCP
.playwright-mcp/

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# Empire schools: genomes and logs stay local (megabytes of floats, rewritten every generation)
apps/empire-train/schools/*.json
apps/empire-train/schools/*.log
apps/empire-train/schools/*-driver.out

# The campaigns' schools (a genome and its parents, tens of MB each): the pools under
# schools/pools are kept, the campaigns keep their logs and measures only
apps/empire-train/schools/s*/*.json
apps/empire-train/schools/s*/*.out
# Recall traces (`--trace`): tens of MB per school, regenerated at will
apps/empire-train/schools/s*/recall/
apps/empire-train/schools/__pycache__/
# llama-modnitor runtime data (public repo: profiles hold local model paths)
apps/llama-modnitor/.env
apps/llama-modnitor/profiles/
apps/llama-modnitor/output.log
